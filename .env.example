# Copy to .env.local for local development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=

# Server-side BFF → API (defaults to NEXT_PUBLIC_API_BASE_URL)
# On a LAN host (e.g. http://10.80.80.220:3000), point this at the API the *Next server* can reach:
#   API_INTERNAL_URL=http://127.0.0.1:8081
#   (or http://10.80.80.220:8081 if the API is on another machine)
API_INTERNAL_URL=http://localhost:8080

# Auth cookies: Secure flag. Omit to auto-detect from the request (http → off, https → on).
# Required for production over plain HTTP (LAN IP) if sessions keep expiring:
COOKIE_SECURE=false
