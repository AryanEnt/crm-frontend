# Copy to .env.local for local development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=

# Server-side BFF → Go API (defaults to NEXT_PUBLIC_API_BASE_URL)
API_INTERNAL_URL=http://localhost:8080

# Auth cookies: Secure flag. Omit to auto-detect from the request (http → off, https → on).
# Set false for production over plain HTTP (LAN IP). Set true behind HTTPS.
# COOKIE_SECURE=false
